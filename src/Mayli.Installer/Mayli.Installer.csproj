<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Mayli.Installer</RootNamespace>
    <AssemblyName>Mayli_Setup</AssemblyName>
    <Version>1.1.65.0</Version>
    <AssemblyVersion>1.1.65.0</AssemblyVersion>
    <FileVersion>1.1.65.0</FileVersion>
    <Company>Modi Studio</Company>
    <Product>Mayli Setup</Product>
    <Description>Mayli - Modern Setup and Onboarding Wizard</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\Mayli\Resources\Vayli.Brand.tray-dark.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\**\*" />
    <EmbeddedResource Include="Payload\**\*" Condition="Exists('Payload')" />
  </ItemGroup>

</Project>
