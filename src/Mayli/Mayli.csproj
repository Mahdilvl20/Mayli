<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WindowsBuddy</RootNamespace>
    <AssemblyName>Mayli</AssemblyName>
    <Version>1.1.60.0</Version>
    <Company>Modi Studio</Company>
    <Product>Mayli</Product>
    <Description>Mayli - the notch for Windows</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationIcon>Resources\Vayli.Brand.tray-dark.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\*.ttf" />
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

</Project>
